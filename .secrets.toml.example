# Copy this file to .secrets.toml and fill in real values.
# .secrets.toml is gitignored and must never be committed.

[gemini]
GEMINI_SCRIPT_GENERATOR = 'gemini-2.5-flash'
GEMINI_PROMPT_GENERATOR = 'gemini-2.5-flash'
GEMINI_STORYBOARD_GENERATOR = 'gemini-2.5-pro'
GEMINI_TEXT_ENHANCER = 'gemini-2.5-pro'
GEMINI_WIKI_EVENTS = 'gemini-2.5-pro'
PROJECT_ID = 'your-gcp-project-id'
LOCATION_ID = 'your-gcp-region'

[gcp.imagen]
PROJECT_ID = 'your-gcp-project-id'
LOCATION_ID = 'your-gcp-region'
MODEL_NAME = 'imagen-4.0-generate-preview-06-06'

[eleven_labs]
API_KEY = ''

[freepik]
API_KEY = ''
